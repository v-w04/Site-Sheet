{
  "manifest_version": 3,
  "name": "Site Sheet - Cookie",
  "version": "1.2.2",
  "description": "Manda al Site Sheet tu sesion de electronicsmexico.site y de Odoo, y cancela en el site las ventas pendientes mientras Chrome y el site esten abiertos.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "idle",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://electronicsmexico.site/*",
    "https://electronicsmexico.odoo.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Sheet - Cookie"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
