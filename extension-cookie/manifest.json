{
  "manifest_version": 3,
  "name": "Site Sheet - Cookie",
  "version": "1.0.0",
  "description": "Cuando entras a electronicsmexico.site manda tu sesion al Site Sheet. Sin pegar cookies a mano.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://electronicsmexico.site/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Site Sheet - Cookie" },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
